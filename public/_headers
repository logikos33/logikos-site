# Cloudflare Pages response headers. The page CSP (with script/style hashes) is emitted by
# Astro as a <meta>; frame-ancestors only works as a header, so it lives here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin

# Preview and *.pages.dev hosts never get indexed; only the custom domain (after cutover) does.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/_marca
  X-Robots-Tag: noindex

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/media/hud/*
  Cache-Control: public, max-age=300

# Generated posters change only with a deploy; a day in cache is plenty.
/media/posters/*
  Cache-Control: public, max-age=86400

# Home media (clips, posters, Koda, partner logos). Not hashed: a week in cache, revalidated in
# the background; a replaced file needs a new name to reach everyone at once.
/media/home/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/media/parceiros/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
