# ---- Build-time (public, inlined into the static site) --------------------------------
# Canonical origin used for canonical/hreflang/sitemap/OG. Keep the final domain here even
# while the site only lives on *.pages.dev (pages.dev hosts are noindex via public/_headers).
PUBLIC_SITE_URL=https://logikosvision.com.br
# Official commercial WhatsApp, digits only with country code (e.g. 55479XXXXXXXX).
# Empty → every WhatsApp CTA falls back to the contact page.
PUBLIC_WHATSAPP_NUMBER=
# Public contact e-mail shown in the footer, contact page, privacy policy and JSON-LD.
PUBLIC_CONTACT_EMAIL=
# Final videos (R2 custom domain, e.g. https://media.logikosvision.com.br). Empty → /media placeholders.
PUBLIC_MEDIA_BASE_URL=
# Turnstile site key. Empty → Cloudflare's always-pass TEST key (preview only).
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Web Analytics token. Empty → no beacon at all.
PUBLIC_CF_ANALYTICS_TOKEN=

# ---- Runtime (Pages Function /api/lead) — set as Pages secrets, never in git ----------
# TURNSTILE_SECRET_KEY=   empty → test secret on *.pages.dev/localhost only; production host fails closed
# LEADS_API_URL=          recognition-leads endpoint (contract pending, see issue)
# LEADS_API_KEY=          bearer token for LEADS_API_URL
# KV binding LEADS_KV → namespace "leads-site" (wrangler.toml; created by scripts/ensure-kv.mjs)
