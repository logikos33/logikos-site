{
  "name": "logikos-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "gate:license": "node scripts/license-gate.mjs",
    "gate:text": "node scripts/text-gate.mjs",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "test:unit": "node --test 'tests/unit/*.test.ts'",
    "gate:i18n": "node scripts/i18n-gate.mjs && node scripts/i18n-dist-gate.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.5",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "satori": "0.33.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "wrangler": "4.146.0"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "sharp"
    ],
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
