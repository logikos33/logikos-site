---
// /sobre (feedback 11/11, item 26): manifesto → what we do (one card per front) → how we work →
// where we are → "Request your custom model". Nothing invented: no numbers, clients or awards.
import Cam from '../components/Cam.astro';
import DefList from '../components/DefList.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import Passos from '../components/Passos.astro';
import Section from '../components/Section.astro';
import SpecialistButton from '../components/SpecialistButton.astro';
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.about;
const f = p.facts;
const facts = [f.model, f.processing].map((x) => ({ term: x.title, text: x.text }));
const KEYS = ['recognition', 'robotics', 'twins'] as const;
const FRONTS = p.fronts.items.map((item, i) => ({ ...item, key: KEYS[i] ?? 'recognition' }));
const how = p.how.items.map((x) => ({ title: x.name, text: x.text }));
---

<Base locale={locale} routeKey="about" title={p.meta.title} description={p.meta.description}>
  <!-- "Engineering that proves before it promises": the proof is the crowd testing it at Fireshow 2026. -->
  <PageHero locale={locale} id="hero-title" title={p.hero.title} text={p.hero.text}>
    <!-- Final review, item 5: only this page's call, no "Try the experience" here. -->
    <Fragment slot="actions">
      <SpecialistButton locale={locale} label={p.cta} interest="custom" />
    </Fragment>
    <figure class="vert">
      <Cam clip="fs-publico" vertical label={t.pages.fireshow.label} />
      <figcaption class="mono">{t.pages.fireshow.caption}</figcaption>
    </figure>
  </PageHero>

  <Section id="why-title" question={p.questions.why} title={p.manifesto.title} text={p.manifesto.text} />

  <Section id="vision-title" question={p.questions.vision} title={p.vision.title} text={p.vision.text} />

  <Section id="fronts-title" question={p.questions.fronts} title={p.fronts.title} wide>
    <ul class="frentes" role="list">
      {FRONTS.map((fr) => (
        <li class="folha">
          <h3>
            <a href={pathFor(fr.key, locale)}>{fr.name}</a>
          </h3>
          <p>{fr.text}</p>
          {'specs' in fr && fr.specs && (
            <div class="specs">
              <p class="specs__rotulo">{p.fronts.specsLabel}</p>
              <ul role="list">
                {fr.specs.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </div>
          )}
        </li>
      ))}
    </ul>
  </Section>

  <!-- Revisão final 2, q1: the three steps as the sequence they are. -->
  <Section id="how-title" question={p.questions.how} title={p.how.title} text={p.how.text} wide>
    <Passos steps={how} />
  </Section>

  <Section id="who-title" question={p.questions.who} title={f.place.title} text={f.place.text}>
    <DefList rows={facts} />
  </Section>

  <PageClose locale={locale} interest="custom" label={p.cta} />
</Base>

<style>
  .vert {
    width: min(100%, 18rem, 31svh);
    margin: 0 auto;
  }

  figcaption {
    margin-top: var(--lk-space-2);
    font-size: 0.8125rem;
    color: var(--lk-text-2);
  }

  .frentes {
    display: grid;
    gap: var(--lk-space-4);
    margin: var(--lk-space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .frentes h3 {
    margin: 0 0 var(--lk-space-2);
    font-size: 1.2rem;
  }

  .frentes h3 a {
    color: var(--lk-text);
    text-decoration-color: var(--lk-accent-2);
  }

  .frentes p {
    margin: 0;
    color: var(--lk-text-2);
  }

  /* Revisão final 2, q5: what Twins connects, short and in topics. */
  .specs {
    margin-top: var(--lk-space-4);
    padding-top: var(--lk-space-3);
    border-top: 1px solid var(--lk-line);
  }

  .specs__rotulo {
    margin: 0 0 var(--lk-space-2) !important;
    font: 600 0.75rem/1.3 var(--lk-font-body);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--lk-text-2);
  }

  .specs ul {
    display: grid;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .specs li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9375rem;
    color: var(--lk-text);
  }

  .specs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 0.4rem;
    background: #0091ad;
  }

  @media (min-width: 48rem) {
    .frentes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
