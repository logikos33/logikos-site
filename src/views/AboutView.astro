---
import DefList from '../components/DefList.astro';
import Section from '../components/Section.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.about;
const f = p.facts;
const facts = [f.nvidia, f.licenses].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="about" title={p.meta.title} description={p.meta.description}>
  <Section as="h1" cover id="hero-title" question={p.hero.question} title={p.hero.title} text={p.hero.text} />

  <Section id="who-title" question={p.questions.who} title={f.place.title} text={f.place.text}>
    <DefList rows={facts} class="after" />
    <div class="btn-row after">
      <WhatsAppButton locale={locale} />
    </div>
  </Section>
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }
</style>
