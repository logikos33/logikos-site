---
// /recognition — PLANO-V2 §5: cover · five readings (stage) · EPI in three states · the alert,
// inside · where it runs · partners · demos · next step. The region avatar (M3) and the live
// demo chips (M7) arrive in the motion round; the structure they hook into is built here.
import AlertCard from '../components/AlertCard.astro';
import Avatar from '../components/Avatar.astro';
import DefList from '../components/DefList.astro';
import HudVideo from '../components/HudVideo.astro';
import Icon from '../components/Icon.astro';
import Pipeline from '../components/Pipeline.astro';
import Section from '../components/Section.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { DEMOS } from '../config/links';
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.recognition;
const q = p.questions;

const READINGS = ['fire', 'epi', 'ergonomics', 'zones', 'counting'] as const;
const STATES = ['ok', 'alert', 'warn'] as const;
const partnerRows = [t.partnerPoints.brand, t.partnerPoints.pilot, t.partnerPoints.license].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="recognition" title={p.meta.title} description={p.meta.description}>
  <Section cover as="h1" question={p.hero.question} title={p.hero.title} text={p.hero.text} id="page-title">
    <div class="btn-row">
      <WhatsAppButton locale={locale} label={t.cta.pilot} />
      <a class="btn btn--ghost" href={pathFor('demos', locale)}>
        {t.cta.demo}
      </a>
    </div>
  </Section>

  <Section question={q.readings} title={p.readings.title} id="readings-title" wide>
    <HudVideo locale={locale} clip="fire" readings id="rec-stage" />
    <div class="reading-texts">
      {READINGS.map((k) => (
        <div data-reading-text data-slot={k} hidden={k !== 'fire'}>
          <dl class="defs">
            <div class="defs__row">
              <dt>{p.readings.fires}</dt>
              <dd>{t.readings[k].fires}</dd>
            </div>
            <div class="defs__row">
              <dt>{p.readings.receives}</dt>
              <dd>{t.readings[k].receives}</dd>
            </div>
            <div class="defs__row">
              <dt>{p.readings.not}</dt>
              <dd>{t.readings[k].not}</dd>
            </div>
          </dl>
        </div>
      ))}
    </div>
  </Section>

  <Section question={q.epi} title={p.epi.title} text={p.epi.text} id="epi-title" wide>
    <Avatar locale={locale} />
    <dl class="defs legend">
      {STATES.map((s) => (
        <div class="defs__row">
          <dt>
            <span class:list={['verdict', `verdict--${s}`]}>
              <Icon name={s} size={12} />
              {t.states[s]}
            </span>
          </dt>
          <dd>{p.epi.states[s]}</dd>
        </div>
      ))}
    </dl>
    <HudVideo locale={locale} clip="epi" />
  </Section>

  <Section question={q.alert} title={p.alertAnatomy.title} text={p.alertAnatomy.text} id="alert-title" wide>
    <div class="split">
      <AlertCard locale={locale} clip="hero" />
      <DefList rows={p.alertAnatomy.rows} />
    </div>
  </Section>

  <Section question={q.where} title={p.where.title} text={p.where.text} id="where-title" wide>
    <Pipeline locale={locale} />
    <p>
      <a href={pathFor('howItWorks', locale)}>{p.where.cta}</a>
    </p>
  </Section>

  <Section question={q.partners} title={p.partners.title} id="partners-title">
    <DefList rows={partnerRows} />
    <p>
      <a href={pathFor('partners', locale)}>{p.partners.cta}</a>
    </p>
  </Section>

  <Section question={q.demo} title={p.demo.title} text={p.demo.text} id="demo-title">
    <div class="btn-row">
      <a class="btn btn--ghost" href={DEMOS.epi} rel="noopener" target="_blank">
        {t.demos.epi.title}
        <span class="visually-hidden"> ({t.a11y.external})</span>
      </a>
      <a class="btn btn--ghost" href={DEMOS.fire} rel="noopener" target="_blank">
        {t.demos.fire.title}
        <span class="visually-hidden"> ({t.a11y.external})</span>
      </a>
    </div>
    <p>
      <a href={pathFor('demos', locale)}>{t.cta.seeDemos}</a>
    </p>
  </Section>

  <Section question={q.next} title={t.home.next.title} id="next-title">
    <div class="btn-row">
      <WhatsAppButton locale={locale} label={t.cta.pilot} />
      <a class="btn btn--ghost" href={pathFor('partners', locale)}>
        {t.cta.partner}
      </a>
    </div>
  </Section>
</Base>

<script>
  // Stage: the reading list on the HUD drives which trio of definition rows is shown.
  const list = document.querySelector<HTMLFieldSetElement>('[data-hud-readings="rec-stage"]');
  list?.addEventListener('change', () => {
    const slot = list.querySelector<HTMLInputElement>('input:checked')?.value;
    for (const el of document.querySelectorAll<HTMLElement>('[data-reading-text]')) el.hidden = el.dataset.slot !== slot;
  });
</script>

<style>
  .reading-texts {
    margin-top: var(--lk-space-5);
  }

  .reading-texts [hidden] {
    display: none;
  }

  .split {
    display: grid;
    gap: var(--lk-space-6);
    align-items: start;
  }

  .legend {
    margin-top: var(--lk-space-5);
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
