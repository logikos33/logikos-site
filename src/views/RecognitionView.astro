---
// /recognition in the home's language (feedback 11/11, item 5): the hero is the monitor wall with
// the real clips; then the five readings side by side, EPI with its three states on the real EPI
// clip, the alert as it arrives, where it runs, partners, demos and the phone-camera close.
import AlertCard from '../components/AlertCard.astro';
import Cam from '../components/Cam.astro';
import DefList from '../components/DefList.astro';
import DemoStatus from '../components/DemoStatus.astro';
import Icon from '../components/Icon.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import PointList from '../components/PointList.astro';
import Section from '../components/Section.astro';
import Wall from '../components/Wall.astro';
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';
import type { IconName } from '../lib/icons';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.recognition;
const q = p.questions;

const READINGS: [keyof typeof t.readings, IconName][] = [
  ['fire', 'flame'],
  ['epi', 'helmet'],
  ['ergonomics', 'posture'],
  ['zones', 'zone'],
  ['counting', 'counter'],
];
const STATES = ['ok', 'alert', 'warn'] as const;
const partnerRows = [t.partnerPoints.brand, t.partnerPoints.pilot, t.partnerPoints.license].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="recognition" title={p.meta.title} description={p.meta.description}>
  <PageHero locale={locale} id="page-title" title={p.hero.title} text={p.hero.text}>
    <Wall locale={locale} clips={['fogo', 'epi', 'qualidade', 'contagem', 'ergonomia']} yours />
  </PageHero>

  <Section question={p.hero.question} title={p.readings.title} id="readings-title" wide>
    <ul class="leituras" role="list">
      {READINGS.map(([k, icon]) => (
        <li class="leitura">
          <h3>
            <Icon name={icon} size={22} />
            {t.readings[k].title}
          </h3>
          <dl>
            <div>
              <dt>{p.readings.fires}</dt>
              <dd>{t.readings[k].fires}</dd>
            </div>
            <div>
              <dt>{p.readings.receives}</dt>
              <dd>{t.readings[k].receives}</dd>
            </div>
            <div>
              <dt>{p.readings.not}</dt>
              <dd>{t.readings[k].not}</dd>
            </div>
          </dl>
        </li>
      ))}
    </ul>
  </Section>

  <Section question={q.epi} title={p.epi.title} text={p.epi.text} id="epi-title" wide>
    <div class="split">
      <figure>
        <Cam clip="v-epi" name={t.pages.cams.epi} />
        <figcaption class="mono">{t.pages.clipNote}</figcaption>
      </figure>
      <dl class="defs legend">
        {STATES.map((s) => (
          <div class="defs__row">
            <dt>
              <span class:list={['verdict', `verdict--${s}`]}>
                <Icon name={s} size={12} />
                {t.states[s]}
              </span>
            </dt>
            <dd>{p.epi.states[s]}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section question={q.alert} title={p.alertAnatomy.title} text={p.alertAnatomy.text} id="alert-title" wide>
    <div class="split">
      <AlertCard locale={locale} clip="hero" />
      <DefList rows={p.alertAnatomy.rows} />
    </div>
  </Section>

  <Section question={q.where} title={p.where.title} text={p.where.text} id="where-title">
    <p>
      <a href={pathFor('howItWorks', locale)}>{p.where.cta}</a>
    </p>
  </Section>

  <Section question={q.partners} title={p.partners.title} id="partners-title">
    <PointList rows={partnerRows} />
    <p>
      <a href={pathFor('partners', locale)}>{p.partners.cta}</a>
    </p>
  </Section>

  <Section question={q.demo} title={p.demo.title} text={p.demo.text} id="demo-title">
    <div class="btn-row">
      <DemoStatus locale={locale} demo="epi" button />
      <DemoStatus locale={locale} demo="fire" button />
    </div>
    <p>
      <a href={pathFor('demos', locale)}>{t.cta.seeDemos}</a>
    </p>
  </Section>

  <PageClose locale={locale} />
</Base>

<style>
  .leituras {
    display: grid;
    margin: var(--lk-space-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--lk-line);
  }

  .leitura {
    display: grid;
    gap: var(--lk-space-3);
    padding-block: var(--lk-space-5);
    border-bottom: 1px solid var(--lk-line);
  }

  .leitura h3 {
    display: flex;
    align-items: center;
    gap: var(--lk-space-3);
    margin: 0;
    font-size: 1.15rem;
  }

  .leitura h3 :global(svg) {
    color: var(--lk-accent);
  }

  .leitura dl {
    display: grid;
    gap: var(--lk-space-3);
    margin: 0;
  }

  .leitura dt {
    font: 500 0.75rem/1.4 var(--lk-font-mono);
    color: var(--lk-text-2);
  }

  .leitura dd {
    margin: 0;
  }

  .split {
    display: grid;
    gap: var(--lk-space-6);
    align-items: start;
    margin-top: var(--lk-space-6);
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: var(--lk-space-2);
    font-size: 0.8125rem;
    color: var(--lk-text-2);
  }

  @media (min-width: 48rem) {
    .leitura dl {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--lk-space-5);
    }
  }

  @media (min-width: 64rem) {
    .leitura {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--lk-space-6);
      align-items: start;
    }

    .split {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
