---
import DefList from '../components/DefList.astro';
import Cam from '../components/Cam.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.twins;
const f = p.features;
const uses = [f.measure, f.annotate, f.parts].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="twins" title={p.meta.title} description={p.meta.description}>
  <!-- Round 5: the digital twin scene (the part on the line and its twin on the monitor). -->
  <PageHero locale={locale} interest="twins" id="hero-title" title={p.hero.title} text={p.hero.text}>
    <figure class="fig">
      <Cam clip="v-gemeo" webm name={t.home.scenarios.twin.name} />
    </figure>
  </PageHero>

  <Section id="how-title" question={p.questions.how} title={f.capture.title} text={f.capture.text}>
    <DefList rows={uses} class="after" />
  </Section>

  <Section id="buy-title" question={p.questions.buy} title={p.buy.title} text={p.buy.text} />

  <PageClose locale={locale} interest="twins" />
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }

  .fig {
    margin: 0;
  }

  .fig figcaption {
    margin-top: var(--lk-space-2);
    font-size: 0.8125rem;
    color: var(--lk-text-2);
  }
</style>
