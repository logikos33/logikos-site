---
import DefList from '../components/DefList.astro';
import Passos from '../components/Passos.astro';
import PointList from '../components/PointList.astro';
import Cam from '../components/Cam.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.twins;
const f = p.features;
// Revisão final 2, q3: the part twin leads; the phone capture of the site is a topic further down.
const phone = [f.capture, f.measure, f.annotate].map((x) => ({ term: x.title, text: x.text }));
// Final review, item 3: the twin of every part gets its own section.
const parts = p.partsPoints.map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="twins" title={p.meta.title} description={p.meta.description}>
  <!-- Round 5: the digital twin scene (the part on the line and its twin on the monitor). -->
  <PageHero locale={locale} interest="twins" id="hero-title" title={p.hero.title} text={p.hero.text}>
    <figure class="fig">
      <Cam clip="v-gemeo" webm name={t.home.scenarios.twin.name} />
    </figure>
  </PageHero>

  <Section id="process-title" question={p.process.question} title={p.process.title} text={p.process.text} wide class="section--perto">
    <Passos steps={p.process.steps} />
  </Section>

  <Section id="parts-title" question={p.parts.question} title={p.parts.title} text={p.parts.text}>
    <PointList rows={parts} />
  </Section>

  <Section id="phone-title" question={p.phone.question} title={p.phone.title} text={p.phone.text}>
    <DefList rows={phone} />
  </Section>

  <Section id="buy-title" question={p.questions.buy} title={p.buy.title} text={p.buy.text} />

  <PageClose locale={locale} interest="twins" />
</Base>

<style>
  .fig {
    margin: 0;
  }

  .fig figcaption {
    margin-top: var(--lk-space-2);
    font-size: 0.8125rem;
    color: var(--lk-text-2);
  }
</style>
