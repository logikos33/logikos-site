---
// Home v3 (approved 11/11/2026, SCRATCH/esboco rodada 3): dark, opening (Koda turns on the TV →
// dive), wall of five live readings + "CAM 07 · yours", partners, Koda, problem, five channels,
// specialist band, camera → decision, Fireshow, data, FAQ, contact. "Talk to a specialist" always
// opens the conversation with Koda on the contact page. No video downloads before
// it is near the screen; reduced motion turns off the opening, carousel, pulse and autoplay.
import Aguardando from '../components/Aguardando.astro';
import Icon from '../components/Icon.astro';
import { EXPERIENCE_URL, PHONE_DEMO_URL } from '../config/links';
import { dict, fill } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, specialistHref, type ChatInterest } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const h = t.home;
const M = '/media/home/';
// Koda with alpha; swap the files (and their sizes, so nothing shifts) when a higher-resolution one arrives.
const KODA = {
  section: { src: `${M}koda-apresentando.webp`, w: 400, h: 365 },
  peek: { src: `${M}koda-apontando.webp`, w: 240, h: 244 },
};

/** Specialist link: the conversation with Koda on the contact page (feedback 11/11, item 11). */
const specialist = (interest?: ChatInterest) => ({ attrs: { href: specialistHref(locale, interest) } });
const general = specialist();

const SCENES = (
  [
    { key: 'fogo', cenario: 'fogo', alert: true, interest: 'fire' },
    { key: 'epi', cenario: 'epi', alert: true, interest: 'epi' },
    { key: 'qualidade', cenario: 'qualidade', alert: false, interest: 'quality' },
    { key: 'contagem', cenario: 'contagem', alert: false, interest: 'counting' },
    { key: 'ergonomia', cenario: null, alert: true, interest: 'ergonomics' },
  ] as const
).map((s, i) => {
  const text = h.scenarios.items[i];
  if (!text) throw new Error(`home.scenarios.items[${i}] missing`);
  return {
    ...s,
    ...text,
    poster: `${M}v-${s.key}`,
    video: `${M}v-${s.key}.mp4`,
    esp: specialist(s.interest),
  };
});
// CH6 (feedback 11/11, round 5): the digital twin — of the plant and of every part. Its panel says
// what it solves and what you get, and asks for a custom model.
const TWIN = {
  ...h.scenarios.twin,
  key: 'gemeo',
  poster: `${M}v-gemeo`,
  video: `${M}v-gemeo.mp4`,
  webm: `${M}v-gemeo.webm`,
  esp: specialist('twins'),
};
const CHANNELS = SCENES.length + 1;

// A still row, whole logos, no mask (feedback 11/11, item 15: the old sliding strip faded its
// edges and showed the Visdec cut as it passed). `k` (tall / medium / wide mark) sets its height for equal visual weight.
const LOGOS = [
  { k: 'alta', src: '/media/parceiros/l-cath-v2.webp', alt: h.partners.cath, w: 117, h: 48 },
  { k: 'media', src: '/media/parceiros/l-brandschutz.webp', alt: h.partners.bs, w: 143, h: 38 },
  { k: 'larga', src: '/media/parceiros/l-visdec-v2.webp', alt: h.partners.visdec, w: 154, h: 30 },
];
const srcset = (base: string) => `${base}-320.webp 320w, ${base}-480.webp 480w, ${base}.webp 640w`;
---

<Base locale={locale} routeKey="home" title={h.meta.title} description={h.meta.description} theme="dark">
  <Fragment slot="head">
    <script is:inline>
      // Opening: once per session; never with reduced motion, data saver or ?sem-abertura.
      // Decided before first paint so the page never flashes under the overlay.
      (() => {
        try {
          const q = location.search + location.hash;
          const saveData = navigator.connection && navigator.connection.saveData;
          if (matchMedia('(prefers-reduced-motion: reduce)').matches || saveData || /sem-abertura/.test(q)) return;
          if (sessionStorage.getItem('lk-abertura') === '1') return;
          document.documentElement.classList.add('lk-abre');
          // The overlay's poster is the first thing on screen: fetch it before the body is parsed.
          const poster = document.createElement('link');
          poster.rel = 'preload';
          poster.as = 'image';
          poster.href = '/media/home/abertura-poster.webp';
          document.head.append(poster);
        } catch {
          // Storage blocked: no opening.
        }
      })();
    </script>
  </Fragment>

  <div class="home">
    <section class="heroi greek-grid" aria-labelledby="hero-title">
      <div class="wrap heroi__grade">
        <div class="heroi__copy">
          <h1 id="hero-title">{h.hero.title}</h1>
          <p class="lead">{h.hero.sub}</p>
          <div class="acoes" data-heroi-acoes>
            <a class="btn" href={EXPERIENCE_URL}>
              {t.cta.experience}
              <Icon name="arrow" size={18} />
            </a>
            <a class="btn btn--ghost" {...general.attrs}>
              <Icon name="chat" size={18} />
              {t.cta.specialist}
            </a>
          </div>
        </div>

        <div class="muro-wrap">
          <div class="muro liga" role="group" aria-label={h.hero.wallLabel}>
            {SCENES.map((s) => (
              <div class="cam">
                <img
                  src={`${s.poster}.webp`}
                  srcset={srcset(s.poster)}
                  sizes="(max-width: 56rem) 50vw, 20vw"
                  alt=""
                  width="640"
                  height="360"
                />
                <video data-src={s.video} data-lazy muted loop playsinline preload="none" aria-hidden="true" />
                <span class="cam__nome">{s.name}</span>
              </div>
            ))}
            <a class="cam cam--voce" href={PHONE_DEMO_URL}>
              <Aguardando locale={locale} compact />
              <span>
                <b>{h.hero.yours.title}</b>
                {h.hero.yours.text}
              </span>
            </a>
            <div class="muro__legenda">
              <span>{h.hero.legend}</span>
              <button type="button" class="parar" data-parar data-label-pause={h.hero.pause} data-label-resume={h.hero.resume}>
                <Icon name="stop" size={16} class="parar__stop" />
                <Icon name="play" size={16} class="parar__play" />
                <span data-parar-texto>{h.hero.pause}</span>
              </button>
            </div>
          </div>
          <a class="espia" href={EXPERIENCE_URL}>
            <img src={KODA.peek.src} alt="" width={KODA.peek.w} height={KODA.peek.h} loading="lazy" />
            <span class="espia__balao">{h.hero.koda}</span>
          </a>
        </div>
      </div>
    </section>

    <div class="parceiros">
      <div class="wrap parceiros__linha">
        <p id="parceiros-titulo">{h.partners.label}</p>
        <ul class="logos" aria-labelledby="parceiros-titulo">
          {LOGOS.map((l) => (
            <li data-logo={l.k}>
              <img src={l.src} alt={l.alt} width={l.w} height={l.h} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </div>

    <section class="koda" aria-labelledby="koda-title">
      <div class="wrap koda__grade">
        <img class="koda__img" src={KODA.section.src} alt={h.koda.alt} width={KODA.section.w} height={KODA.section.h} loading="lazy" />
        <div class="koda__copy">
          <h2 id="koda-title">{h.koda.title}</h2>
          <p class="lead">{h.koda.text}</p>
          <div class="acoes">
            <a class="btn" href={EXPERIENCE_URL}>
              {h.koda.cta}
              <Icon name="arrow" size={18} />
            </a>
          </div>
          <p class="nota">{h.koda.note}</p>
        </div>
      </div>
    </section>

    <section class="problema" aria-labelledby="problema-title">
      <div class="wrap problema__grade">
        <h2 id="problema-title">
          {h.problem.title} <span>{h.problem.muted}</span>
        </h2>
        <p class="lead">{h.problem.text}</p>
      </div>
    </section>

    <section class="cenarios" id="cenarios" aria-labelledby="cenarios-title">
      <div class="wrap">
        <div class="cab">
          <h2 id="cenarios-title">{h.scenarios.title}</h2>
          <p class="lead">{h.scenarios.text}</p>
        </div>
        <!-- A real carousel (feedback 11/11, item 9): the slides sit side by side on a scroll-snap
             track (native swipe/drag on touch), with discreet arrows and the channel names as the
             indicator ruler (the selected one fills while it plays). Off-screen slides are inert. -->
        <div
          class="carrossel"
          data-carrossel
          role="region"
          aria-roledescription={h.scenarios.roledescription}
          aria-label={h.scenarios.tabsLabel}
        >
          <div class="trilho" data-trilho tabindex="-1">
            {SCENES.map((s, i) => (
              <div
                class="slide"
                role="group"
                aria-roledescription={h.scenarios.slideRole}
                aria-label={`${fill(h.scenarios.slide, { n: String(i + 1), total: String(CHANNELS) })}: ${s.name}`}
                id={`painel-${s.key}`}
                data-slide
                inert={i !== 0}
              >
                <div>
                  <div class="monitor liga">
                    <div class="cam">
                      <img src={`${s.poster}.webp`} alt="" width="640" height="360" loading="lazy" />
                      <video data-src={s.video} data-lazy muted loop playsinline preload="none" aria-hidden="true" />
                    </div>
                  </div>
                  <p class="fonte">{s.source}</p>
                </div>
                <div class="ticket">
                  <p class:list={['estado', { 'estado--ok': !s.alert }]}>
                    <Icon name={s.alert ? 'alert' : 'ok'} size={16} />
                    {s.state}
                  </p>
                  <dl>
                    <dt>{h.scenarios.camera}</dt>
                    <dd>{s.cam}</dd>
                    <dt>{h.scenarios.when}</dt>
                    <dd class="mono">{h.scenarios.time}</dd>
                    <dt>{h.scenarios.evidence}</dt>
                    <dd>{s.evidence}</dd>
                    <dt>{h.scenarios.norm}</dt>
                    <dd>{s.norm}</dd>
                    <dt>{h.scenarios.notified}</dt>
                    <dd>{s.notified}</dd>
                  </dl>
                  <p class="quem">{s.who}</p>
                  {s.cenario ? (
                    <>
                      <a class="btn" href={`${EXPERIENCE_URL}?cenario=${s.cenario}`}>
                        {s.cta}
                        <Icon name="arrow" size={18} />
                      </a>
                      <a class="link-esp" {...s.esp.attrs}>
                        <Icon name="chat" size={16} />
                        {s.specialist}
                      </a>
                    </>
                  ) : (
                    <a class="btn" {...s.esp.attrs}>
                      <Icon name="chat" size={18} />
                      {s.cta}
                    </a>
                  )}
                </div>
              </div>
            ))}
            <div
              class="slide"
              role="group"
              aria-roledescription={h.scenarios.slideRole}
              aria-label={`${fill(h.scenarios.slide, { n: String(CHANNELS), total: String(CHANNELS) })}: ${TWIN.name}`}
              id="painel-gemeo"
              data-slide
              inert
            >
              <div>
                <div class="monitor liga">
                  <div class="cam">
                    <img src={`${TWIN.poster}.webp`} alt="" width="640" height="360" loading="lazy" />
                    <video data-src={TWIN.video} data-webm={TWIN.webm} data-lazy muted loop playsinline preload="none" aria-hidden="true" />
                  </div>
                </div>
                <p class="fonte">{TWIN.source}</p>
              </div>
              <div class="ticket">
                <p class="estado estado--ok">
                  <Icon name="ok" size={16} />
                  {TWIN.state}
                </p>
                <dl class="ticket__twin">
                  <dt>{h.scenarios.solves}</dt>
                  <dd>{TWIN.solves}</dd>
                  <dt>{h.scenarios.gets}</dt>
                  <dd>{TWIN.gets}</dd>
                </dl>
                <a class="btn" {...TWIN.esp.attrs}>
                  <Icon name="chat" size={18} />
                  {TWIN.cta}
                </a>
              </div>
            </div>
          </div>
          <div class="controles">
            <button type="button" class="seta" data-anterior aria-label={h.scenarios.prev}>
              <Icon name="arrow" size={18} class="seta__esq" />
            </button>
            <ol class="regua" data-regua>
              {SCENES.map((s, i) => (
                <li>
                  <button type="button" data-ir={i} aria-current={i === 0 ? 'true' : undefined} aria-controls={`painel-${s.key}`}>
                    <span class="regua__ch">{s.tab}</span>
                    <span class="regua__nome">{s.name}</span>
                    <span class="regua__prog" aria-hidden="true"></span>
                  </button>
                </li>
              ))}
              <li>
                <button type="button" data-ir={SCENES.length} aria-controls="painel-gemeo">
                  <span class="regua__ch">{TWIN.tab}</span>
                  <span class="regua__nome">{TWIN.name}</span>
                  <span class="regua__prog" aria-hidden="true"></span>
                </button>
              </li>
            </ol>
            <button type="button" class="seta" data-proximo aria-label={h.scenarios.next}>
              <Icon name="arrow" size={18} />
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="faixa" aria-labelledby="faixa-title">
      <div class="wrap faixa__grade">
        <div>
          <h2 id="faixa-title">{h.band.title}</h2>
          <p class="lead">{h.band.text}</p>
        </div>
        <div class="acoes" data-faixa-acoes>
          <a class="btn" href={PHONE_DEMO_URL}>
            <Icon name="camera" size={18} />
            {h.band.cta}
          </a>
          <a class="btn btn--ghost" {...general.attrs}>
            <Icon name="chat" size={18} />
            {t.cta.specialist}
          </a>
        </div>
      </div>
    </section>

    <section class="como" id="como" aria-labelledby="como-title">
      <div class="wrap">
        <div class="cab">
          <h2 id="como-title">{h.how.title}</h2>
        </div>
        <div class="como__grade">
          <svg class="diagrama liga" viewBox="0 0 620 300" role="img" aria-label={h.how.diagram}>
            <path class="fio" d="M128 150 H232"></path>
            <path class="pulso" d="M128 150 H232"></path>
            <path class="fio" d="M368 150 H462"></path>
            <path class="pulso pulso--2" d="M368 150 H462"></path>
            <g transform="translate(40 110)">
              <rect class="caixa" width="88" height="80" rx="6"></rect>
              <rect class="icone" x="16" y="28" width="40" height="26" rx="3"></rect>
              <path class="icone" d="M56 36l14-7v24l-14-7"></path>
              <circle class="icone" cx="30" cy="41" r="6"></circle>
            </g>
            <text class="t" x="40" y="236">
              {h.how.camera}
            </text>
            <text x="40" y="258">
              {h.how.cameraSub}
            </text>
            <g transform="translate(232 96)">
              <rect class="caixa" width="136" height="108" rx="6"></rect>
              <g class="opA">
                <path class="icone" d="M44 66h48a16 16 0 0 0 0-32a22 22 0 0 0-42-4a18 18 0 0 0-6 36z"></path>
              </g>
              <g class="opB">
                <rect class="icone" x="40" y="34" width="56" height="40" rx="3"></rect>
                <path class="icone" d="M50 46h36M50 56h36M50 66h22"></path>
              </g>
            </g>
            <text class="t opA" x="232" y="236">
              {h.how.cloud}
            </text>
            <text class="opA" x="232" y="258">
              {h.how.cloudSub}
            </text>
            <text class="t opB" x="232" y="236">
              {h.how.plant}
            </text>
            <text class="opB" x="232" y="258">
              {h.how.plantSub}
            </text>
            <g transform="translate(462 90)">
              <g class="opA">
                <rect class="caixa" x="18" width="70" height="120" rx="10"></rect>
                <path class="icone" d="M40 58l10 10 18-20"></path>
              </g>
              <g class="opB">
                <rect class="caixa" y="16" width="112" height="84" rx="6"></rect>
                <path class="icone" d="M18 74l18-18 14 12 22-26 20 16"></path>
              </g>
            </g>
            <text class="t opA" x="462" y="236">
              {h.how.phone}
            </text>
            <text class="opA" x="462" y="258">
              {h.how.phoneSub}
            </text>
            <text class="t opB" x="462" y="236">
              {h.how.dashboard}
            </text>
            <text class="opB" x="462" y="258">
              {h.how.dashboardSub}
            </text>
            <text class="escolha" x="40" y="52">
              {h.how.choose}
            </text>
          </svg>
          <ol class="passos">
            {h.how.steps.map((p) => (
              <li>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="prova" id="prova" aria-labelledby="prova-title">
      <div class="wrap">
        <div class="cab">
          <h2 id="prova-title">{h.proof.title}</h2>
        </div>
        <div class="prova__grade">
          <figure class="vert liga">
            <div class="clip">
              <img src={`${M}fs-publico.webp`} alt="" width="464" height="832" loading="lazy" />
              <video
                data-src={`${M}fs-publico.mp4`}
                data-lazy
                muted
                loop
                playsinline
                preload="none"
                aria-label={h.proof.publicLabel}
              ></video>
            </div>
            <figcaption>{h.proof.publicCaption}</figcaption>
          </figure>
          <div class="lado">
            <div class="itens">
              <div class="item">
                <span class="item__data">{h.proof.event.date}</span>
                <h3>{h.proof.event.title}</h3>
                <p>{h.proof.event.text}</p>
              </div>
              <div class="item">
                <span class="item__data">{h.proof.demo.date}</span>
                <h3>{h.proof.demo.title}</h3>
                <p>{h.proof.demo.text}</p>
                <a href={PHONE_DEMO_URL}>{h.proof.demo.cta}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="dados" id="dados" aria-labelledby="dados-title">
      <div class="wrap dados__grade">
        <div class="cab">
          <h2 id="dados-title">{h.data.title}</h2>
          <p class="lead">{h.data.text}</p>
        </div>
        <table>
          <caption class="visually-hidden">{h.data.title}</caption>
          <thead>
            <tr>
              <th scope="col">{h.data.leaves}</th>
              <th scope="col">{h.data.stays}</th>
            </tr>
          </thead>
          <tbody>
            {h.data.rows.map(([a, b]) => (
              <tr>
                <td>{a}</td>
                <td>{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="faq" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq__grade">
        <div class="cab">
          <h2 id="faq-title">{h.faq.title}</h2>
        </div>
        <div>
          {h.faq.items.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <Icon name="plus" size={20} class="faq__mais" />
              </summary>
              <p>
                {f.a}
                {i === h.faq.items.length - 1 && (
                  <>
                    {' '}
                    <a href={pathFor('privacy', locale)}>{h.faq.privacy}</a>
                  </>
                )}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="contato" id="contato" aria-labelledby="contato-title">
      <div class="wrap">
        <div class="cartao">
          <div class="cartao__copy">
            <h2 id="contato-title">{h.contact.title}</h2>
            <p class="lead">{h.contact.text}</p>
            <div class="acoes">
              <a class="btn btn--ghost" href={EXPERIENCE_URL}>
                {t.cta.experience}
                <Icon name="arrow" size={18} />
              </a>
            </div>
            {CONTACT_EMAIL && (
              <a class="email mono" href={`mailto:${CONTACT_EMAIL}`}>
                {CONTACT_EMAIL}
              </a>
            )}
          </div>
          <!-- The page ends where it began: one more camera on the wall, waiting for the visitor's signal. -->
          <div class="sinal">
            <div class="sinal__tela">
              <Aguardando locale={locale} />
              <p class="sinal__osd mono">
                <span class="sinal__rec" aria-hidden="true"></span>
                {h.contact.screen}
              </p>
              <div class="acoes" data-contato-acoes>
                <a class="btn" {...general.attrs}>
                  <Icon name="chat" size={18} />
                  {t.cta.specialist}
                </a>
              </div>
              <p class="sinal__sub mono">{h.contact.screenSub}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <Fragment slot="after">
    <div class="barra" role="region" aria-label={h.bar.label} data-barra>
      <a class="btn" href={EXPERIENCE_URL}>
        {t.cta.experience}
        <Icon name="arrow" size={18} />
      </a>
      <a class="btn btn--ghost barra__esp" {...general.attrs}>
        <Icon name="chat" size={18} />
        <span aria-hidden="true">{h.bar.specialist}</span>
        <span class="visually-hidden">{t.cta.specialist}</span>
      </a>
    </div>

    <div class="abertura" role="dialog" aria-modal="true" aria-label={h.opening.label} data-abertura>
      <div class="abertura__palco">
        <video data-src={`${M}abertura.mp4`} poster={`${M}abertura-poster.webp`} muted playsinline preload="none"></video>
      </div>
      <div class="abertura__flash"></div>
      <button type="button" class="abertura__pular" data-pular>
        {h.opening.skip}
      </button>
    </div>
  </Fragment>
</Base>

<script>
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Opening: Koda turns on the TV, the camera dives in, the site opens. It plays whole (or until
  // "Pular", Esc or a tap). Fail-safes: not playable within 8 s, stalled for 3 s mid-clip, or
  // past its length + 3 s → the site opens at once. The rest of the page is inert meanwhile.
  const opened = new Promise<void>((resolve) => {
    const ab = document.querySelector<HTMLElement>('[data-abertura]');
    const video = ab?.querySelector('video');
    const skip = ab?.querySelector<HTMLButtonElement>('[data-pular]');
    if (!root.classList.contains('lk-abre') || !ab || !video || !skip) {
      ab?.remove();
      resolve();
      return;
    }
    const rest = [...document.body.children].filter((e): e is HTMLElement => e !== ab && e instanceof HTMLElement);
    rest.forEach((e) => (e.inert = true));
    video.src = video.dataset.src ?? '';
    skip.focus({ focusVisible: false } as FocusOptions);
    let done = false;
    let playing = false;
    const close = () => {
      root.classList.remove('lk-abre', 'lk-entrando');
      ab.remove();
      resolve();
    };
    const finish = (skipped: boolean) => {
      if (done) return;
      done = true;
      try {
        sessionStorage.setItem('lk-abertura', '1');
      } catch {
        // Storage blocked: it may play again next load.
      }
      rest.forEach((e) => (e.inert = false));
      // Focus moves to the start of the page either way (never left on <body>).
      document.querySelector<HTMLElement>('.site-header__logo')?.focus({ preventScroll: true, focusVisible: false } as FocusOptions);
      if (skipped) {
        close();
        return;
      }
      ab.classList.add('mergulha');
      window.setTimeout(() => root.classList.add('lk-entrando'), 500);
      window.setTimeout(close, 1200);
    };
    // The clock starts when the clip can play through, never at page load: a fast page with a cold
    // cache used to hit the old 1.2 s / 0.6 s fail-safes while the clip was still downloading and
    // cut the opening. The poster holds the screen meanwhile; "Pular" works the whole time.
    let stall = 0;
    let cap = 0;
    const start = () => {
      if (playing || done) return;
      playing = true;
      window.clearTimeout(boot);
      video.play().catch(() => finish(true));
      // Whole clip + 3 s of buffering slack, counted from the first frame.
      cap = window.setTimeout(() => finish(false), ((video.duration || 5) + 3) * 1000);
    };
    // Nothing playable after 8 s (very slow network or a broken file): open the site.
    const boot = window.setTimeout(() => finish(true), 8000);
    video.addEventListener('playing', () => window.clearTimeout(stall));
    // Mid-clip stalls wait for data (up to 3 s) instead of cutting the opening.
    const onStall = () => {
      if (!playing) return;
      window.clearTimeout(stall);
      stall = window.setTimeout(() => finish(true), 3000);
    };
    video.addEventListener('waiting', onStall);
    video.addEventListener('stalled', onStall);
    video.addEventListener('ended', () => {
      window.clearTimeout(cap);
      finish(false);
    });
    video.addEventListener('canplaythrough', start);
    video.preload = 'auto';
    video.load();
    if (video.readyState >= 4) start();
    // Only deliberate gestures skip: the button, Esc or a tap on the opening. Scroll and touchmove
    // no longer do (trackpad inertia right after load was cutting it).
    skip.addEventListener('click', () => finish(true));
    ab.addEventListener('keydown', (e) => e.key === 'Escape' && finish(true));
    ab.addEventListener('pointerdown', (e) => e.target !== skip && finish(true));
  });

  // ---- Videos: nothing downloads before it is near the screen; off-screen ones pause; reduced
  // motion keeps the posters. One visible control stops every moving thing (WCAG 2.2.2).
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video[data-lazy]')];
  const near = new Set<HTMLVideoElement>();
  // Data saver or a slow connection starts paused on the posters; "Resume" opts in.
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  let stopped = reduce || Boolean(conn?.saveData) || /(^|-)(2g|3g)$/.test(conn?.effectiveType ?? '');
  const play = (v: HTMLVideoElement) => {
    if (stopped) return;
    // WebM where the browser plays VP9 (lighter), MP4 everywhere else.
    if (!v.getAttribute('src'))
      v.src = (v.dataset.webm && v.canPlayType('video/webm; codecs="vp9"') ? v.dataset.webm : v.dataset.src) ?? '';
    v.play().catch(() => {});
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          near.add(v);
          play(v);
        } else {
          near.delete(v);
          if (v.getAttribute('src')) v.pause();
        }
      }
    },
    { rootMargin: '200px' },
  );
  void opened.then(() => videos.forEach((v) => io.observe(v)));

  const stopButton = document.querySelector<HTMLButtonElement>('[data-parar]');
  const syncStop = () => {
    root.classList.toggle('lk-parado', stopped);
    if (!stopButton) return;
    stopButton.setAttribute('aria-pressed', String(stopped));
    const label = stopButton.querySelector('[data-parar-texto]');
    if (label) label.textContent = (stopped ? stopButton.dataset.labelResume : stopButton.dataset.labelPause) ?? '';
  };
  syncStop();
  stopButton?.addEventListener('click', () => {
    stopped = !stopped;
    if (stopped) videos.forEach((v) => v.pause());
    else near.forEach(play);
    syncStop();
  });

  // ---- Channels: a real carousel. Slides sit side by side on a scroll-snap track, so touch swipe
  // and trackpad drag are native; arrows and the ruler of channel names move it too. The ruler's
  // fill is the timer (its animation ending moves to the next slide); it runs only while the
  // carousel is on screen, not hovered or focused, and never under reduced motion or the stop
  // control. Whatever moved it (swipe, arrow, ruler, timer), the slide that settles is the current
  // one: the others are inert, so keyboard and screen readers stay on what is shown.
  const carousel = document.querySelector<HTMLElement>('[data-carrossel]');
  const track = carousel?.querySelector<HTMLElement>('[data-trilho]');
  const slides = [...(carousel?.querySelectorAll<HTMLElement>('[data-slide]') ?? [])];
  const marks = [...(carousel?.querySelectorAll<HTMLButtonElement>('[data-ir]') ?? [])];
  let current = 0;
  const mark = (i: number) => {
    if (i === current && slides[i] && !slides[i].inert) return;
    current = i;
    slides.forEach((sl, k) => {
      sl.inert = k !== i;
      if (k !== i) sl.querySelector('video')?.pause();
    });
    marks.forEach((m, k) => (k === i ? m.setAttribute('aria-current', 'true') : m.removeAttribute('aria-current')));
  };
  const go = (i: number) => {
    const n = slides.length;
    const to = ((i % n) + n) % n;
    const sl = slides[to];
    if (!track || !sl) return;
    track.scrollTo({ left: sl.offsetLeft - track.offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
    mark(to);
  };
  if (carousel && track) {
    // The slide that is mostly in view after a swipe becomes the current one.
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) mark(slides.indexOf(e.target as HTMLElement));
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((sl) => seen.observe(sl));
    carousel.querySelector('[data-anterior]')?.addEventListener('click', () => go(current - 1));
    carousel.querySelector('[data-proximo]')?.addEventListener('click', () => go(current + 1));
    marks.forEach((m, i) => m.addEventListener('click', () => go(i)));
    carousel.addEventListener('keydown', (e) => {
      if ((e.target as Element).closest('input, textarea')) return;
      const to = { ArrowRight: current + 1, ArrowLeft: current - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      go(to);
    });
    if (!reduce) {
      carousel.dataset.gira = '';
      new IntersectionObserver(([e]) => e && carousel.classList.toggle('em-tela', e.isIntersecting), { threshold: 0.35 }).observe(carousel);
      carousel.addEventListener('animationend', (e) => {
        if ((e.target as Element).classList.contains('regua__prog')) go(current + 1);
      });
    }
  }

  // ---- One pair of CTAs on screen at a time. Desktop: the header's appear once the hero's
  // scrolled away. Phones: the shortcut bar is always there, except while the band's or the
  // contact's own buttons are on screen.
  const heroActions = document.querySelector('[data-heroi-acoes]');
  if (heroActions) {
    new IntersectionObserver(([e]) => {
      if (e) root.classList.toggle('lk-heroi-acoes', e.isIntersecting);
    }).observe(heroActions);
  }
  const bar = document.querySelector<HTMLElement>('[data-barra]');
  const own = [...document.querySelectorAll('[data-faixa-acoes], [data-contato-acoes]')];
  if (bar && own.length) {
    const showing = new Set<Element>();
    const watch = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) showing.add(e.target);
        else showing.delete(e.target);
      }
      bar.classList.toggle('some', showing.size > 0);
    });
    own.forEach((el) => watch.observe(el));
  }
</script>

