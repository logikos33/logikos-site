---
import Icon from '../components/Icon.astro';
import CrmForm from '../components/CrmForm.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import PointList from '../components/PointList.astro';
import Section from '../components/Section.astro';
import Wall from '../components/Wall.astro';
import SpecialistButton from '../components/SpecialistButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.partners;
const pp = t.partnerPoints;
const points = [pp.brand, pp.pilot, pp.license, pp.support].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="partners" title={p.meta.title} description={p.meta.description}>
  <PageHero locale={locale} id="hero-title" title={p.hero.title} text={p.hero.text}>
    <Fragment slot="actions">
      <a class="btn" href="#parceria">
        {t.cta.partner}
        <Icon name="arrow" size={18} />
      </a>
      <SpecialistButton locale={locale} variant="ghost" interest="partnership" />
    </Fragment>
    <!-- What the partner resells: the same readings the home shows, on the client's cameras. -->
    <Wall locale={locale} clips={['fogo', 'epi', 'qualidade', 'contagem']} />
  </PageHero>

  <Section id="model-title" question={p.questions.model} title={p.model.title} text={p.model.text}>
    <PointList rows={points} class="after" />
  </Section>

  <Section id="partner-form-title" question={p.questions.form} title={p.form.title} text={p.form.text}>
    <CrmForm locale={locale} kind="integrador" id="parceria" />
  </Section>

  <PageClose locale={locale} interest="partnership" />
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }
</style>
