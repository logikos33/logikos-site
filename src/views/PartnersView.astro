---
import LeadForm from '../components/LeadForm.astro';
import PointList from '../components/PointList.astro';
import Section from '../components/Section.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.partners;
const pp = t.partnerPoints;
const points = [pp.brand, pp.license, pp.pilot, pp.support].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="partners" title={p.meta.title} description={p.meta.description}>
  <Section as="h1" cover id="hero-title" question={p.hero.question} title={p.hero.title} text={p.hero.text}>
    <div class="btn-row after">
      <a class="btn" href="#parceria">
        <span class="btn__mark" aria-hidden="true"></span>
        {t.cta.partner}
      </a>
      <WhatsAppButton locale={locale} variant="ghost" message={t.cta.whatsappPartnerMessage} />
    </div>
  </Section>

  <Section id="model-title" question={p.questions.model} title={p.model.title} text={p.model.text}>
    <PointList rows={points} class="after" />
  </Section>

  <Section id="partner-form-title" question={p.questions.form} title={p.form.title} text={p.form.text}>
    <div class="form-wrap after">
      <LeadForm locale={locale} kind="partner" id="parceria" />
    </div>
  </Section>
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }

  .form-wrap {
    max-width: 52rem;
  }
</style>
