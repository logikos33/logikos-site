---
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';
import { CONTACT_EMAIL, whatsappHref } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.contact;
const hasWhatsapp = Boolean(whatsappHref(''));
---

<Base locale={locale} routeKey="contact" title={p.meta.title} description={hasWhatsapp ? p.meta.description : p.meta.descriptionNoWhatsapp}>
  <PageHero eyebrow={p.hero.eyebrow} title={p.hero.title} text={hasWhatsapp ? p.hero.text : p.hero.textNoWhatsapp} />

  <section class="section section--flush" aria-label={p.hero.title}>
    <div class="container contact-grid">
      <div class="contact-channels">
        {hasWhatsapp && (
          <article class="card">
            <h2 class="contact-channels__title">
              <Icon name="chat" /> {p.whatsapp.title}
            </h2>
            <p>{p.whatsapp.text}</p>
            <div class="card__foot">
              <WhatsAppButton locale={locale} />
            </div>
          </article>
        )}
        {CONTACT_EMAIL && (
          <article class="card">
            <h2 class="contact-channels__title">
              <Icon name="mail" /> {p.email.title}
            </h2>
            <p>
              <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
            </p>
          </article>
        )}
      </div>
      <div>
        <h2 class="contact-form-title">{p.form.title}</h2>
        <p class="contact-form-text">{p.form.text}</p>
        <LeadForm locale={locale} kind="contact" id="formulario" />
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: var(--lk-space-7);
  }

  .contact-grid > * {
    min-width: 0;
  }

  .contact-channels {
    display: grid;
    gap: var(--lk-space-4);
    align-content: start;
  }

  .contact-channels__title,
  .contact-form-title {
    display: flex;
    align-items: center;
    gap: var(--lk-space-2);
    font-size: 1.25rem;
    margin: 0;
  }

  .contact-form-text {
    color: var(--lk-text-2);
    margin: var(--lk-space-2) 0 var(--lk-space-5);
  }

  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: 1fr 2fr;
    }
  }
</style>
