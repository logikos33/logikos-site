---
// /contato is the conversation with Koda (feedback 11/11, item 11): every "Talk to a specialist" on
// the site lands here (#conversa), and the lead goes to the CRM. The email lives in the footer
// only (round 5); WhatsApp shows beside the chat once the number is configured.
import KodaChat from '../components/KodaChat.astro';
import PageHero from '../components/PageHero.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';
import { whatsappHref } from '../lib/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.contact;
const c = p.chat;
const wa = whatsappHref(t.cta.whatsappMessage);
---

<Base locale={locale} routeKey="contact" title={p.meta.title} description={p.meta.description}>
  <PageHero locale={locale} id="hero-title" title={c.title} text={c.text} quiet>
    {wa && (
      <p slot="note" class="alt">
        <a href={wa} rel="noopener" target="_blank">
          {p.whatsapp.title}
          <span class="visually-hidden">({t.a11y.externalWhatsapp})</span>
        </a>
      </p>
    )}
    <KodaChat locale={locale} />
  </PageHero>
</Base>

<style>
  .alt {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    color: var(--lk-text-2);
    font-size: 0.9375rem;
  }
</style>
