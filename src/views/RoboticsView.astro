---
import DefList from '../components/DefList.astro';
import HudVideo from '../components/HudVideo.astro';
import Section from '../components/Section.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.robotics;
const pts = p.points;
const uses = [pts.quadrupeds, pts.project].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="robotics" title={p.meta.title} description={p.meta.description}>
  <Section as="h1" cover id="hero-title" question={p.questions.what} title={p.hero.title} text={p.hero.text}>
    <p class="after">
      <span class="verdict verdict--outline">{p.chip}</span>
    </p>
    <div class="btn-row after">
      <WhatsAppButton locale={locale} />
    </div>
  </Section>

  <Section id="how-title" question={p.questions.how} title={pts.drones.title} text={pts.drones.text} wide>
    <HudVideo locale={locale} clip="robotics" class="after" />
    <p class="note">{t.hud.illustrative}</p>
    <DefList rows={uses} class="after" />
  </Section>

  <Section id="buy-title" question={p.questions.buy} title={p.buy.title} text={p.buy.text}>
    <div class="btn-row after">
      <WhatsAppButton locale={locale} />
    </div>
  </Section>
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }

  .note {
    margin-top: var(--lk-space-3);
  }
</style>
