---
import FeatureList from '../components/FeatureList.astro';
import HudVideo from '../components/HudVideo.astro';
import PageHero from '../components/PageHero.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.robotics;
---

<Base locale={locale} routeKey="robotics" title={p.meta.title} description={p.meta.description}>
  <PageHero eyebrow={p.hero.eyebrow} title={p.hero.title} text={p.hero.text} chip={p.chip}>
    <div class="btn-row">
      <WhatsAppButton locale={locale} />
    </div>
  </PageHero>

  <section class="section" aria-label={p.hero.title}>
    <div class="container stack">
      <HudVideo locale={locale} slot="robotics" />
      <FeatureList items={[p.points.drones, p.points.quadrupeds, p.points.project]} />
    </div>
  </section>
</Base>

<style>
  .stack {
    display: grid;
    gap: var(--lk-space-7);
  }
</style>
