---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import Cam from '../components/Cam.astro';
import DefList from '../components/DefList.astro';
import Koda from '../components/Koda.astro';
import SpecialistButton from '../components/SpecialistButton.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.robotics;
const pts = p.points;
const uses = [pts.drones, pts.quadrupeds, pts.project].map((x) => ({ term: x.title, text: x.text }));
// Revisão final 2, q4: the drone + quadruped loop takes the right column as soon as its files are in
// public/media/robotica/ (drones-loop.mp4/.webm + drones-loop.webp poster); until then, the uses.
const LOOP = existsSync(join(process.cwd(), 'public/media/robotica/drones-loop.mp4'));
---

<Base locale={locale} routeKey="robotics" title={p.meta.title} description={p.meta.description}>
  <!-- No robot footage of our own yet: Koda carries the hero instead of a mock clip (feedback 11/11, item 5). -->
  <PageHero locale={locale} interest="robotics" id="hero-title" title={p.hero.title} text={p.hero.text}>
    <!-- Final review, item 9: only this page's call. -->
    <Fragment slot="actions">
      <SpecialistButton locale={locale} interest="robotics" />
    </Fragment>
    <p slot="note">
      <span class="verdict verdict--outline">{p.chip}</span>
    </p>
    <Koda locale={locale} pose="apontando" />
  </PageHero>

  <Section id="how-title" question={p.questions.how} title={pts.both.title} text={pts.both.text}>
    {LOOP && <Cam clip="drones-loop" dir="robotica" webm label={p.loopLabel} class="loop" />}
    <DefList rows={uses} />
  </Section>

  <Section id="buy-title" question={p.questions.buy} title={p.buy.title} text={p.buy.text} />

  <PageClose locale={locale} interest="robotics" />
</Base>

<style>
  :global(.q-content .loop) {
    margin-bottom: var(--lk-space-4);
  }
</style>
