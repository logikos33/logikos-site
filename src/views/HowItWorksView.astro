---
import Pipeline from '../components/Pipeline.astro';
import PointList from '../components/PointList.astro';
import Section from '../components/Section.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.howItWorks;
const i = p.integrations;
const integrations = [i.alarm, i.mqtt, i.webhook].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="howItWorks" title={p.meta.title} description={p.meta.description}>
  <Section as="h1" cover id="hero-title" question={p.hero.question} title={p.hero.title} text={p.hero.text} wide>
    <!-- The figure this page exists for, in its hero (AUDITORIA-V2 F-10). -->
    <Pipeline locale={locale} long class="after" />
  </Section>

  <Section id="offline-title" question={p.questions.offline} title={p.offline.title} text={p.offline.text} />

  <Section id="integrations-title" question={p.questions.integrations} title={p.integrations.title}>
    <PointList rows={integrations} class="after" />
  </Section>

  <Section id="license-title" question={p.questions.license} title={p.license.title} text={p.license.text}>
    <div class="btn-row after">
      <WhatsAppButton locale={locale} />
    </div>
  </Section>
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }
</style>
