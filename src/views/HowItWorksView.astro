---
import FeatureList from '../components/FeatureList.astro';
import HowItWorks from '../components/HowItWorks.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.howItWorks;
---

<Base locale={locale} routeKey="howItWorks" title={p.meta.title} description={p.meta.description}>
  <PageHero eyebrow={p.hero.eyebrow} title={p.hero.title} text={p.hero.text} />

  <section class="section section--flush" aria-label={p.hero.title}>
    <div class="container">
      <HowItWorks locale={locale} />
    </div>
  </section>

  <section class="section" aria-labelledby="offline-title">
    <div class="container">
      <SectionHead title={p.offline.title} text={p.offline.text} id="offline-title" />
    </div>
  </section>

  <section class="section" aria-labelledby="integrations-title">
    <div class="container">
      <SectionHead title={p.integrations.title} id="integrations-title" />
      <FeatureList items={[p.integrations.alarm, p.integrations.mqtt, p.integrations.webhook]} />
    </div>
  </section>

  <section class="section" aria-labelledby="license-title">
    <div class="container">
      <SectionHead title={p.license.title} text={p.license.text} id="license-title">
        <div class="btn-row">
          <WhatsAppButton locale={locale} />
        </div>
      </SectionHead>
    </div>
  </section>
</Base>
