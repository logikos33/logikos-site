---
import DemoStatus from '../components/DemoStatus.astro';
import Section from '../components/Section.astro';
import { DEMOS } from '../config/links';
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.demos;
const demos = ['epi', 'fire'] as const;
---

<Base locale={locale} routeKey="demos" title={p.meta.title} description={p.meta.description}>
  <Section as="h1" cover question={p.hero.question} title={p.hero.title} text={p.hero.text} id="demos-title">
    <!-- The real thing first, with its live state; the mock stage is gone (AUDITORIA-V2 F-14). -->
    <div class="btn-row hero-actions">
      {demos.map((k) => (
        <DemoStatus locale={locale} demo={k} button primary />
      ))}
    </div>
    <p class="note">{p.browser}</p>
  </Section>

  {demos.map((k) => (
    <Section question={p.questions[k]} title={p[k].title} text={p[k].see} id={`demo-${k}`}>
      <p>{p[k].verdict}</p>
      <p class="note">{p[k].note}</p>
      <div class="btn-row">
        <a class="btn" href={DEMOS[k]} rel="noopener" target="_blank">
          <span class="btn__mark" aria-hidden="true" />
          {t.cta.openDemo}
          <span class="visually-hidden"> ({t.a11y.external})</span>
        </a>
      </div>
    </Section>
  ))}

  <Section question={p.questions.note} title={p.note.title} text={p.note.text} id="demos-note">
    <p>
      <a href={pathFor('recognition', locale)}>{t.nav.recognition}</a>
    </p>
  </Section>
</Base>

<style>
  .hero-actions {
    margin-top: var(--lk-space-5);
  }

  .note {
    color: var(--lk-text-2);
    font-size: 0.9375rem;
    max-width: var(--lk-measure);
  }
</style>
