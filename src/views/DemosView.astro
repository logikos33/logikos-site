---
import Cam from '../components/Cam.astro';
import DemoStatus from '../components/DemoStatus.astro';
import Icon from '../components/Icon.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { EXPERIENCE_URL, PHONE_DEMO_URL } from '../config/links';
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.demos;
const demos = [
  ['epi', 'v-epi', t.pages.cams.epi],
  ['fire', 'v-fogo', t.pages.cams.fogo],
] as const;
---

<Base locale={locale} routeKey="demos" title={p.meta.title} description={p.meta.description}>
  <PageHero locale={locale} id="demos-title" title={p.hero.title} text={p.hero.text}>
    <!-- One click to the phone demo (the same as the home's "CAM 07 · yours"), each open demo shows its live state below. -->
    <Fragment slot="actions">
      <a class="btn" href={PHONE_DEMO_URL} data-cta="phone-demo">
        <Icon name="camera" size={18} />
        {t.pages.close.phone}
      </a>
      <a class="btn btn--ghost" href={EXPERIENCE_URL} data-cta="experience">
        {t.cta.experience}
        <Icon name="arrow" size={18} />
      </a>
    </Fragment>
    <p slot="note" class="note">
      {p.browser}
    </p>
    <figure class="vert">
      <Cam clip="fs-publico" vertical label={t.pages.fireshow.label} />
      <figcaption class="mono">{t.pages.fireshow.caption}</figcaption>
    </figure>
  </PageHero>

  {demos.map(([k, clip, name]) => (
    <Section question={p.questions[k]} title={p[k].title} text={p[k].see} id={`demo-${k}`} wide>
      <div class="split">
        <figure>
          <Cam clip={clip} name={name} />
          <figcaption class="mono">{t.pages.clipNote}</figcaption>
        </figure>
        <div class="texto">
          <p>{p[k].verdict}</p>
          <p class="note">{p[k].note}</p>
          <div class="btn-row">
            <DemoStatus locale={locale} demo={k} primary label={t.cta.openDemo} />
          </div>
        </div>
      </div>
    </Section>
  ))}

  <Section question={p.questions.note} title={p.note.title} text={p.note.text} id="demos-note">
    <p>
      <a href={pathFor('recognition', locale)}>{t.nav.recognition}</a>
    </p>
  </Section>

  <PageClose locale={locale} />
</Base>

<style>
  .note {
    max-width: var(--lk-measure);
  }

  figure {
    margin: 0;
  }

  figcaption {
    margin-top: var(--lk-space-2);
    font-size: 0.8125rem;
    color: var(--lk-text-2);
  }

  /* The Fireshow clip is portrait: keep it a phone-sized column, centred in the media cell. */
  .vert {
    /* Portrait clip: never taller than about half the screen on a phone. */
    width: min(100%, 20rem, 31svh);
    margin-inline: auto;
  }

  .split {
    display: grid;
    gap: var(--lk-space-6);
    align-items: center;
    margin-top: var(--lk-space-6);
  }

  .texto {
    display: grid;
    gap: var(--lk-space-4);
  }

  .texto p {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .split {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }
</style>
