---
import DefList from '../components/DefList.astro';
import Section from '../components/Section.astro';
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.compliance;
const i = p.items;
const items = [i.signage, i.roles, i.retention].map((x) => ({ term: x.title, text: x.text }));
---

<Base locale={locale} routeKey="compliance" title={p.meta.title} description={p.meta.description}>
  <Section as="h1" cover id="hero-title" question={p.hero.question} title={p.hero.title} text={p.hero.text} />

  <Section id="items-title" question={p.hero.question} title={i.presence.title} text={i.presence.text}>
    <DefList rows={items} class="after" />
    <p class="note after">{p.note}</p>
    <p class="after">
      <a href={pathFor('privacy', locale)}>{p.cta}</a>
    </p>
  </Section>
</Base>

<style>
  .after {
    margin-top: var(--lk-space-6);
  }

  .note.after {
    margin-top: var(--lk-space-5);
  }

  .note + .after {
    margin-top: var(--lk-space-4);
  }
</style>
