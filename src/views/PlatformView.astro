---
import Cam from '../components/Cam.astro';
import LeadForm from '../components/LeadForm.astro';
import PageClose from '../components/PageClose.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Base from '../layouts/Base.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const p = t.platform;
---

<Base locale={locale} routeKey="platform" title={p.meta.title} description={p.meta.description}>
  <PageHero locale={locale} id="platform-title" title={p.hero.title} text={p.hero.text}>
    <!-- No "Sign in" until the new platform exists (feedback 11/11): the hero keeps the site's pair. -->
    <figure class="fig">
      <Cam clip="v-contagem" name={t.pages.cams.contagem} />
      <figcaption class="mono">{t.pages.clipNote}</figcaption>
    </figure>
  </PageHero>

  <Section question={p.questions.compare} title={p.compare.title} id="compare-title" wide>
    <!-- The one place a table is the content: the two modes, aspect by aspect. -->
    <div class="folha tabela">
      <table class="compare">
        <caption class="visually-hidden">{p.compare.title}</caption>
        <thead>
          <tr>
            <th scope="col">{p.compare.aspect}</th>
            <th scope="col">{p.compare.edge}</th>
            <th scope="col">{p.compare.cloud}</th>
          </tr>
        </thead>
        <tbody>
          {p.compare.rows.map((r) => (
            <tr>
              <th scope="row">{r.term}</th>
              <td data-edge={p.compare.edge}>{r.edge}</td>
              <td data-cloud={p.compare.cloud}>{r.cloud}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <Section question={p.questions.account} title={p.account.title} text={p.account.text} id="account-title">
    <p>{p.account.confirm}</p>
    <div class="account-form">
      <LeadForm locale={locale} kind="account" id="conta" />
    </div>
  </Section>

  <PageClose locale={locale} />
</Base>

<style>
  .fig {
    margin: 0;
  }

  .fig figcaption {
    margin-top: var(--lk-space-2);
    font-size: 0.8125rem;
    color: var(--lk-text-2);
  }

  .tabela {
    margin-top: var(--lk-space-5);
  }

  .compare {
    width: 100%;
    border-collapse: collapse;
  }

  .compare th,
  .compare td {
    text-align: left;
    vertical-align: top;
    padding: var(--lk-space-3) var(--lk-space-4) var(--lk-space-3) 0;
    border-bottom: 1px solid var(--lk-line);
  }

  .compare thead th {
    font-family: var(--lk-font-display);
    font-weight: 500;
    border-bottom: var(--lk-rule);
  }

  .compare tbody th {
    font-weight: 500;
    width: 9rem;
  }

  .compare td {
    color: var(--lk-text-2);
  }

  @media (max-width: 47.99rem) {
    /* Phone: each aspect becomes a block with the two modes stacked. */
    .compare thead {
      display: none;
    }

    .compare tr,
    .compare th,
    .compare td {
      display: block;
      width: auto;
      padding-right: 0;
    }

    .compare tr {
      border-bottom: var(--lk-rule);
      padding-block: var(--lk-space-3);
    }

    .compare th,
    .compare td {
      border: 0;
      padding-block: var(--lk-space-1);
    }

    .compare td::before {
      display: block;
      font-weight: 500;
      color: var(--lk-text);
    }

    .compare td:nth-child(2)::before {
      content: attr(data-edge);
    }

    .compare td:nth-child(3)::before {
      content: attr(data-cloud);
    }
  }

  .account-form {
    max-width: 52rem;
    margin-top: var(--lk-space-5);
  }
</style>
