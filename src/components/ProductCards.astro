---
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
---

<ul class="grid grid--2 products" role="list">
  <li class="card">
    <h3>
      <a class="products__link" href={pathFor('twins', locale)}>
        {t.products.twins.title}
      </a>
    </h3>
    <p>{t.products.twins.text}</p>
  </li>
  <li class="card">
    <div class="products__head">
      <h3>
        <a class="products__link" href={pathFor('robotics', locale)}>
          {t.products.robotics.title}
        </a>
      </h3>
      <span class="chip" data-chip="by-project">
        {t.products.robotics.chip}
      </span>
    </div>
    <p>{t.products.robotics.text}</p>
  </li>
</ul>

<style>
  .products {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .products__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--lk-space-3);
  }

  .products__link {
    color: var(--lk-text);
    text-decoration: none;
  }

  .products__link:hover {
    text-decoration: underline;
  }

  .products__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .products .card {
    position: relative;
  }

  .products .card:has(.products__link:focus-visible) {
    outline: 2px solid var(--lk-focus);
    outline-offset: 3px;
  }

  .products__link:focus-visible {
    outline: none;
  }
</style>
