---
import { EXPERIENCE_URL, LOGIN_URL } from '../config/links';
import { dict } from '../i18n';
import { HTML_LANG, LOCALES, pathFor, type Locale, type RouteKey } from '../i18n/routes';
import { whatsappHref } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
}

const { locale, routeKey } = Astro.props;
const t = dict(locale);
// Six items. Twins and Robotics are secondary (home §6 and footer).
const NAV: RouteKey[] = ['recognition', 'howItWorks', 'demos', 'platform', 'partners', 'about'];
// "Talk to a specialist" opens WhatsApp; without a configured number it falls back to the contact page.
const wa = whatsappHref(t.home.wa);
const ctaHref = wa ?? pathFor('contact', locale);
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="site-header__logo" href={pathFor('home', locale)} aria-label={t.a11y.home}>
      <Logo locale={locale} size={20} decorative />
    </a>

    <nav class="site-nav" aria-label={t.a11y.mainNav}>
      <ul>
        {NAV.map((key) => (
          <li>
            <a href={pathFor(key, locale)} aria-current={key === routeKey ? 'page' : undefined}>
              {t.nav[key]}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__tools">
      <ul class="lang-switch" aria-label={t.a11y.langSwitch}>
        {LOCALES.map((l) => (
          <li>
            {l === locale ? (
              <span class="lang-switch__current" aria-current="true" lang={HTML_LANG[l]}>
                <span class="visually-hidden">
                  {l === 'pt-br' ? t.lang['pt-brName'] : t.lang.enName} — {t.a11y.langCurrent}
                </span>
                <span aria-hidden="true">{t.lang[l]}</span>
              </span>
            ) : (
              <a href={pathFor(routeKey ?? 'home', l)} hreflang={HTML_LANG[l]} lang={HTML_LANG[l]} data-lang-link>
                <span class="visually-hidden">{l === 'pt-br' ? t.lang['pt-brName'] : t.lang.enName}</span>
                <span aria-hidden="true">{t.lang[l]}</span>
              </a>
            )}
          </li>
        ))}
      </ul>

      <a class="site-header__login" href={LOGIN_URL} rel="noopener" target="_blank" data-login>
        {t.nav.login}
        <span class="visually-hidden">
          {' '}
          — {t.a11y.login} ({t.a11y.external})
        </span>
      </a>

      <!-- Button system: specialist = chat icon on the left (ghost), experience = arrow on the right (solid). -->
      <a
        class="btn btn--ghost btn--md site-header__cta site-header__cta--specialist"
        href={ctaHref}
        {...(wa ? { rel: 'noopener', target: '_blank' } : {})}
        data-cta="whatsapp"
      >
        <Icon name="chat" size={18} />
        <span class="site-header__cta-label">{t.cta.specialist}</span>
        {wa && <span class="visually-hidden">({t.a11y.externalWhatsapp})</span>}
      </a>
      <a class="btn btn--md site-header__cta" href={EXPERIENCE_URL} data-cta="experience">
        {t.cta.experience}
        <Icon name="arrow" size={18} />
      </a>

      <details class="mobile-nav">
        <summary aria-label={t.a11y.menu}>
          <Icon name="menu" class="mobile-nav__open" />
          <Icon name="close" class="mobile-nav__close" />
        </summary>
        <div class="mobile-nav__panel">
          <ul>
            {NAV.map((key) => (
              <li>
                <a href={pathFor(key, locale)} aria-current={key === routeKey ? 'page' : undefined}>
                  {t.nav[key]}
                </a>
              </li>
            ))}
            <li>
              <a href={pathFor('contact', locale)} aria-current={routeKey === 'contact' ? 'page' : undefined}>
                {t.nav.contact}
              </a>
            </li>
            <li>
              <a href={LOGIN_URL} rel="noopener" target="_blank">
                {t.nav.login}
                <span class="visually-hidden">
                  {' '}
                  — {t.a11y.login} ({t.a11y.external})
                </span>
              </a>
            </li>
          </ul>
          <div class="mobile-nav__ctas">
            <a class="btn" href={EXPERIENCE_URL}>
              {t.cta.experience}
              <Icon name="arrow" size={18} />
            </a>
            <a class="btn btn--ghost" href={ctaHref} {...(wa ? { rel: 'noopener', target: '_blank' } : {})}>
              <Icon name="chat" size={18} />
              {t.cta.specialist}
              {wa && <span class="visually-hidden">({t.a11y.externalWhatsapp})</span>}
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Mobile menu (<details>): close on Escape, when focus leaves it, or on a click outside.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-nav')) {
    const summary = menu.querySelector('summary');
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });
    menu.addEventListener('focusout', (event) => {
      if (menu.open && !menu.contains(event.relatedTarget as Node | null)) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--lk-bg);
    border-bottom: 1px solid var(--lk-line);
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--lk-space-4);
    min-height: 4rem;
  }

  .site-header__logo {
    display: inline-flex;
    align-items: center;
    /* Protection area: 1x (x ≈ cap height of the wordmark). */
    padding: 0.7em 0.7em 0.7em 0;
    font-size: 20px;
    text-decoration: none;
    color: var(--lk-text);
  }

  .site-nav {
    display: none;
    margin-right: auto;
  }

  .site-nav ul,
  .lang-switch,
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-nav ul {
    display: flex;
    gap: 0;
  }

  .site-nav a,
  .mobile-nav li a,
  .site-header__login {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 var(--lk-space-3);
    color: var(--lk-text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a:hover,
  .mobile-nav li a:hover,
  .site-header__login:hover {
    text-decoration: underline;
  }

  .site-nav a[aria-current='page'],
  .mobile-nav li a[aria-current='page'] {
    color: var(--lk-link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--lk-space-2);
    margin-left: auto;
  }

  .lang-switch {
    display: flex;
    font: 500 0.8125rem/1 var(--lk-font-mono);
  }

  .lang-switch a,
  .lang-switch__current {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    color: var(--lk-text-2);
    text-decoration: none;
  }

  .lang-switch a {
    color: var(--lk-link);
  }

  .lang-switch a:hover {
    text-decoration: underline;
  }

  .lang-switch__current {
    color: var(--lk-text);
    font-weight: 700;
  }

  .mobile-nav summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--lk-line);
    border-radius: var(--lk-radius);
    background: transparent;
    color: var(--lk-text);
    cursor: pointer;
  }

  .mobile-nav summary:hover {
    border-color: var(--lk-line-strong);
  }

  .site-header__login,
  .site-header__cta {
    display: none;
    white-space: nowrap;
  }

  .mobile-nav summary {
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav[open] .mobile-nav__open,
  .mobile-nav:not([open]) .mobile-nav__close {
    display: none;
  }

  .mobile-nav__panel {
    position: absolute;
    inset: 4rem 0 auto 0;
    background: var(--lk-bg);
    border-bottom: 1px solid var(--lk-line);
    padding: var(--lk-space-3) var(--lk-gutter) var(--lk-space-5);
  }

  .mobile-nav__panel li a {
    width: 100%;
    min-height: 3rem;
    padding: 0;
    font-size: 1.0625rem;
  }

  .mobile-nav__ctas {
    display: grid;
    gap: var(--lk-space-3);
    margin-top: var(--lk-space-4);
    padding-top: var(--lk-space-4);
    border-top: 1px solid var(--lk-line);
  }

  .mobile-nav__ctas .btn {
    width: 100%;
  }

  @media (max-width: 23.99rem) {
    .site-header__bar {
      gap: var(--lk-space-2);
    }

    .site-header__logo {
      padding-right: 0.4em;
    }

    .site-header__tools {
      gap: var(--lk-space-1);
    }

    .lang-switch a,
    .lang-switch__current {
      min-width: 2.25rem;
    }
  }

  @media (min-width: 40rem) {
    .site-header__cta {
      display: inline-flex;
    }

    .site-header__cta--specialist {
      display: none;
    }
  }

  @media (min-width: 52rem) {
    .site-header__cta--specialist {
      display: inline-flex;
    }
  }

  /* Beside the six-item nav the specialist button turns compact (chat icon, label for screen
     readers) so the pair never blinks out between widths; the home's wider bar restores the label. */
  @media (min-width: 72rem) {
    .site-header__cta--specialist {
      width: 2.75rem;
      padding: 0;
    }

    .site-header__cta-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .site-header__bar {
      gap: var(--lk-space-2);
    }

    .site-nav a,
    .site-header__login {
      padding-inline: 0.375rem;
      font-size: 0.875rem;
    }

    .site-header__cta:not(.site-header__cta--specialist) {
      padding-inline: var(--lk-space-3);
    }

    .site-nav,
    .site-header__login {
      display: block;
    }

    .site-header__login {
      display: inline-flex;
    }

    .mobile-nav {
      display: none;
    }
  }

  /* From 90rem the 82.5rem bar has room for the full specialist label (measured: no overflow). */
  @media (min-width: 90rem) {
    .site-header__cta--specialist {
      width: auto;
      padding-inline: var(--lk-space-4);
    }

    .site-header__cta-label {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
    }
  }

  /* One pair of calls to action on screen at a time: the header's wait until the page hero's
     scroll away (the hero toggles .lk-heroi-acoes, on the home and on every page). */
  :global(.lk-heroi-acoes) .site-header__cta {
    visibility: hidden;
  }
</style>
