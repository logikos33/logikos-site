---
// Definition rows on a light sheet (.folha): term on the left (display face), proof on the right.
// The one list shape of the site — doors, gains, integrations, edge/cloud, next steps.
interface Row {
  term: string;
  text: string;
}

interface Props {
  rows: Row[];
  class?: string;
}

const { rows, class: className } = Astro.props;
---

<dl class:list={['defs', 'folha', className]}>
  {rows.map((r) => (
    <div class="defs__row">
      <dt>{r.term}</dt>
      <dd>{r.text}</dd>
    </div>
  ))}
</dl>
