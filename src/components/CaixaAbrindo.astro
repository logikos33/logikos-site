---
// The Logikos box opening (feedback 11/11, item 16): closed box → open box with the device, the
// network cable and the power supply, then a marker on each, in order. Plays once, the first time
// it enters the view. Without JavaScript or with reduced motion it rests on the last frame (box
// open, markers shown). Photos from the Logikos experience (public/experiencia/logikos), resized.
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const c = t.howItWorks.box;
// Markers on the open-box photo; their anchors live in the CSS (.m0–.m2): the site's CSP blocks
// inline style attributes.
const MARKS = [c.device, c.network, c.power];
---

<figure class="caixa" data-caixa>
  <div class="caixa__palco">
    <img class="caixa__aberta" src="/media/caixa/caixa-aberta.webp" alt={c.alt} width="640" height="480" loading="lazy" />
    <img class="caixa__fechada" src="/media/caixa/caixa-fechada.webp" alt="" width="640" height="480" loading="lazy" />
    {MARKS.map((m, i) => (
      <span class:list={['caixa__marca', `m${i}`]} aria-hidden="true">
        <span class="caixa__ponto" />
        <span class="caixa__rotulo">{m}</span>
      </span>
    ))}
  </div>
  <figcaption>{c.caption}</figcaption>
</figure>

<script>
  // Armed only when motion is allowed: the box starts closed and opens once, on first sight.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const fig of document.querySelectorAll<HTMLElement>('[data-caixa]')) {
      fig.classList.add('armada');
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          fig.classList.add('abre');
        },
        { threshold: 0.5 },
      );
      io.observe(fig);
    }
  }
</script>

<style>
  .caixa {
    margin: 0;
    padding: clamp(0.75rem, 2vw, 1.25rem);
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 22px 48px -28px #000;
  }

  .caixa__palco {
    position: relative;
    aspect-ratio: 4 / 3;
  }

  .caixa__palco img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .caixa figcaption {
    margin-top: var(--lk-space-2);
    color: #5c616b;
    font-size: 0.875rem;
    text-align: center;
  }

  /* Anchors on the photo: the device, the network cable, the power supply (and their order). */
  .m0 {
    --x: 30%;
    --y: 48%;
    --i: 0;
  }

  .m1 {
    --x: 66%;
    --y: 30%;
    --i: 1;
  }

  .m2 {
    --x: 64%;
    --y: 62%;
    --i: 2;
  }

  .caixa__marca {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transform: translate(-0.45rem, -50%);
  }

  .caixa__ponto {
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
    background: #0a0a0f;
    border: 3px solid #00d4ff;
    border-radius: 50%;
  }

  .caixa__rotulo {
    padding: 0.2rem 0.5rem;
    background: #0a0a0f;
    border-radius: 4px;
    color: #f4f6f8;
    font: 600 0.75rem/1.2 var(--lk-font-body);
    white-space: nowrap;
  }

  /* Armed (motion allowed, not seen yet): closed box, nothing marked. */
  .armada .caixa__aberta {
    opacity: 0;
    transform: scale(0.96);
  }

  .armada .caixa__marca {
    opacity: 0;
    transform: translate(-0.45rem, -30%);
  }

  /* Opening: the lid lifts out of view, the open box settles in, then each part is pointed out. */
  .armada.abre .caixa__fechada {
    opacity: 0;
    transform: translateY(-6%) scale(1.04);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s,
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  .armada.abre .caixa__aberta {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.45s,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.45s;
  }

  .armada.abre .caixa__marca {
    opacity: 1;
    transform: translate(-0.45rem, -50%);
    transition:
      opacity 0.4s ease-out calc(1.3s + var(--i) * 0.35s),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) calc(1.3s + var(--i) * 0.35s);
  }

  .caixa:not(.armada) .caixa__fechada {
    opacity: 0;
  }

  @media (max-width: 30rem) {
    .caixa__rotulo {
      font-size: 0.6875rem;
    }
  }
</style>
