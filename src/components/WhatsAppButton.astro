---
// "Talk to a specialist", as on the home: chat icon, WhatsApp with a context message. While
// PUBLIC_WHATSAPP_NUMBER is unset it goes to the contact page with the same words, so no button
// ever promises a WhatsApp channel that does not exist.
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import { whatsappHref } from '../lib/site';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  label?: string;
  message?: string;
  variant?: 'solid' | 'ghost';
}

const { locale, label, message, variant = 'solid' } = Astro.props;
const t = dict(locale);
const href = whatsappHref(message ?? t.cta.whatsappMessage);
---

<a
  class:list={['btn', { 'btn--ghost': variant === 'ghost' }]}
  href={href ?? pathFor('contact', locale)}
  data-cta="whatsapp"
  {...(href ? { rel: 'noopener', target: '_blank' } : {})}
>
  <Icon name="chat" size={18} />
  {label ?? t.cta.specialist}
  {href && <span class="visually-hidden">({t.a11y.externalWhatsapp})</span>}
</a>
