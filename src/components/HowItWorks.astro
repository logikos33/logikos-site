---
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const STEPS: { key: keyof typeof t.steps; icon: IconName }[] = [
  { key: 'camera', icon: 'camera' },
  { key: 'device', icon: 'chip' },
  { key: 'verdict', icon: 'bell' },
];
---

<ol class="steps" role="list">
  {STEPS.map(({ key, icon }, i) => (
    <li class="step">
      <div class="step__head">
        <span class="step__n mono" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <Icon name={icon} size={24} />
      </div>
      <h3>{t.steps[key].title}</h3>
      <p>{t.steps[key].text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--lk-space-5);
  }

  .step {
    border-top: 2px solid var(--lk-text);
    padding-top: var(--lk-space-4);
  }

  .step__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--lk-space-4);
  }

  .step__n {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--lk-text-2);
  }

  .step h3 {
    margin-bottom: var(--lk-space-2);
  }

  .step p {
    color: var(--lk-text-2);
    margin: 0;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--lk-space-6);
    }
  }
</style>
