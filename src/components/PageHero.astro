---
// Section cover for inner pages. The "grid grego" lives only on covers like this one.
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  chip?: string;
}

const { eyebrow, title, text, chip } = Astro.props;
---

<section class="page-hero greek-grid" aria-labelledby="page-title">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title">{title}</h1>
    {chip && (
      <span class="chip page-hero__chip" data-chip="by-project">
        {chip}
      </span>
    )}
    {text && <p class="lede">{text}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .page-hero h1 {
    max-width: 18ch;
  }

  .page-hero__chip {
    margin-bottom: var(--lk-space-4);
  }

  .page-hero :global(.btn-row) {
    margin-top: var(--lk-space-5);
  }
</style>
