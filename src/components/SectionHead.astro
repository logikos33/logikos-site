---
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  as?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, text, as: Tag = 'h2', id } = Astro.props;
---

<div class="section-head">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id}>{title}</Tag>
  {text && <p>{text}</p>}
  <slot />
</div>
