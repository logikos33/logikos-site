---
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const d = t.home.doors;
---

<section class="section section--flush" aria-labelledby="doors-title">
  <div class="container">
    <h2 id="doors-title" class="visually-hidden">
      {d.title}
    </h2>
    <div class="grid grid--2 doors">
      <article class="card door">
        <p class="eyebrow">{d.plant.eyebrow}</p>
        <h3>{d.plant.title}</h3>
        <p>{d.plant.text}</p>
        <div class="card__foot">
          <WhatsAppButton locale={locale} label={d.plant.cta} />
        </div>
      </article>
      <article class="card door">
        <p class="eyebrow">{d.partner.eyebrow}</p>
        <h3>{d.partner.title}</h3>
        <p>{d.partner.text}</p>
        <div class="card__foot">
          <a class="btn" href={pathFor('partners', locale)}>
            <span class="btn__mark" aria-hidden="true"></span>
            {d.partner.cta}
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .door {
    padding: var(--lk-space-6);
  }

  .door h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
  }
</style>
