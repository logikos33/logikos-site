---
import { dict } from '../i18n';
import { pathFor, type Locale, type RouteKey } from '../i18n/routes';
import { COMPANY, CONTACT_EMAIL } from '../lib/site';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const year = new Date().getFullYear();
const LINKS = [
  'cases',
  'recognition',
  'howItWorks',
  'demos',
  'platform',
  'partners',
  'twins',
  'robotics',
  'compliance',
  'about',
  'contact',
] as const satisfies readonly RouteKey[];
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <Logo locale={locale} variant="lockup" size={56} />
      <p class="site-footer__tagline">{t.brand.tagline}</p>
      <!-- Only true, checkable commitments (the privacy policy says each of them); no certifications. -->
      <ul class="selos" aria-label={t.footer.seals.label}>
        <li>
          <a href={pathFor('privacy', locale)}>
            <Icon name="doc" size={14} />
            {t.footer.seals.lgpd}
          </a>
        </li>
        <li>
          <Icon name="eyeoff" size={14} />
          {t.footer.seals.cookies}
        </li>
        <li>
          <Icon name="ok" size={14} />
          {t.footer.seals.sale}
        </li>
      </ul>
    </div>

    <nav aria-label={t.a11y.footerNav}>
      <ul class="site-footer__links">
        {LINKS.map((key) => (
          <li>
            <a href={pathFor(key, locale)}>{t.nav[key]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <address class="site-footer__legal">
      <span>{t.footer.company}</span>
      <span class="mono">
        {t.footer.cnpjLabel} {COMPANY.cnpj}
      </span>
      {CONTACT_EMAIL && <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>}
      <a href={pathFor('privacy', locale)}>{t.nav.privacy}</a>
      <button type="button" class="site-footer__prefs" data-consent-open>
        {t.consent.prefs}
      </button>
      <span class="mono">
        © {year} {t.footer.company}. {t.footer.rights}
      </span>
    </address>
  </div>
</footer>

<style>
  .site-footer__prefs {
    align-self: start;
    min-height: 2.25rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--lk-link-on-dark, var(--lk-accent));
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .selos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lk-space-2);
    margin: var(--lk-space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .selos li,
  .selos a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .selos li {
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--lk-line-strong);
    border-radius: 999px;
    font: 500 0.75rem/1.2 var(--lk-font-mono);
    color: var(--lk-text-2);
  }

  .selos :global(svg) {
    flex: none;
    color: var(--lk-accent, #00d4ff);
  }

  .selos a {
    color: inherit;
    text-decoration: none;
  }

  .selos a:hover {
    color: var(--lk-text);
  }

  .site-footer {
    border-top: 1px solid var(--lk-line);
    padding-block: var(--lk-space-7) var(--lk-space-6);
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--lk-space-6);
  }

  .site-footer__tagline {
    margin: var(--lk-space-3) 0 0;
    font-family: var(--lk-font-display);
    font-weight: 500;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--lk-space-1) var(--lk-space-5);
  }

  .site-footer__links a {
    display: inline-flex;
    min-height: 2.25rem;
    align-items: center;
    color: var(--lk-text);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    text-decoration: underline;
  }

  .site-footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--lk-space-1);
    font-style: normal;
    color: var(--lk-text-2);
  }

  .site-footer__legal .mono {
    font-size: 0.8125rem;
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1fr 1.4fr 1.2fr;
    }
  }
</style>
