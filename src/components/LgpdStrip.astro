---
import { dict } from '../i18n';
import { pathFor, type Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const l = t.home.lgpd;
---

<div class="lgpd">
  <div>
    <p class="eyebrow">{l.eyebrow}</p>
    <h2 id="lgpd-title">{l.title}</h2>
  </div>
  <div>
    <ul class="lgpd__lines" role="list">
      {l.lines.map((line) => (
        <li>{line}</li>
      ))}
    </ul>
    <a class="link-arrow" href={pathFor('compliance', locale)}>
      {l.cta}
    </a>
  </div>
</div>

<style>
  .lgpd {
    display: grid;
    gap: var(--lk-space-5);
  }

  .lgpd__lines {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--lk-space-5);
    display: grid;
    gap: var(--lk-space-3);
  }

  .lgpd__lines li {
    font-size: 1.125rem;
    padding-left: var(--lk-space-4);
    border-left: 2px solid var(--lk-line-strong);
  }

  @media (min-width: 48rem) {
    .lgpd {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--lk-space-7);
    }
  }
</style>
