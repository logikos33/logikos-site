---
// Provisional logo system until the official vector wordmark from the brand manual lands
// (see docs/decisions and the `brand` issue):
// - wordmark: live text "LOGIKOS" in Space Grotesk 700, tracking .16em — the lockup the
//   Recognition app uses today (apps/frontend/src/app/acesso/Marca.tsx on develop);
// - monogram: solid circle with the Λ knocked out — official path from the Recognition
//   loader (docs/design/handoff-f5/lk-loader.js, monogramSvg). Used below the 90 px wordmark minimum.
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';

interface Props {
  locale: Locale;
  variant?: 'wordmark' | 'monogram';
  /** Wordmark font size in px (cap height ≈ 0.7 × size). Monogram edge in px. */
  size?: number;
  class?: string;
  glitch?: boolean;
}

const { locale, variant = 'wordmark', size = 20, class: className, glitch = false } = Astro.props;
const t = dict(locale);
const maskId = `lk-mono-${size}`;
---

{variant === 'wordmark' ? (
  <span class:list={['lk-wordmark', className, { 'lk-glitch': glitch }]} data-text={t.brand.wordmark} data-size={size}>
    {t.brand.wordmark}
  </span>
) : (
  <svg class:list={['lk-monogram', className]} width={size} height={size} viewBox="0 0 100 100" aria-hidden="true">
    <defs>
      <mask id={maskId}>
        <rect x="-20" y="-20" width="140" height="140" fill="#fff" />
        <polyline points="27,79 50,27 73,79" fill="none" stroke="#000" stroke-width="10" stroke-linejoin="miter" stroke-miterlimit="8" />
      </mask>
    </defs>
    <circle cx="50" cy="50" r="46" fill="currentColor" mask={`url(#${maskId})`} />
  </svg>
)}

<style>
  .lk-wordmark {
    display: inline-block;
    position: relative;
    font-family: var(--lk-font-display);
    font-weight: 700;
    letter-spacing: 0.16em;
    /* Optical correction: tracking adds trailing space after the last letter. */
    margin-right: -0.16em;
    line-height: 1;
    color: var(--lk-text);
    white-space: nowrap;
  }

  .lk-wordmark[data-size='18'] {
    font-size: 18px;
  }

  .lk-wordmark[data-size='20'] {
    font-size: 20px;
  }

  .lk-wordmark[data-size='64'] {
    font-size: clamp(36px, 9vw, 64px);
  }

  .lk-monogram {
    color: var(--lk-text);
    flex: none;
  }
</style>
