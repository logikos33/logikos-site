---
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import type { IconName } from '../lib/icons';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = dict(locale);
const ITEMS: { key: keyof typeof t.scenarios; icon: IconName }[] = [
  { key: 'fire', icon: 'flame' },
  { key: 'epi', icon: 'helmet' },
  { key: 'ergonomics', icon: 'posture' },
  { key: 'zones', icon: 'zone' },
  { key: 'counting', icon: 'counter' },
];
---

<ul class="grid grid--5 scenarios" role="list">
  {ITEMS.map(({ key, icon }, i) => (
    <li class="card scenario">
      <span class="scenario__index mono" aria-hidden="true">
        {String(i + 1).padStart(2, '0')}
      </span>
      <Icon name={icon} size={22} class="scenario__icon" />
      <h3>{t.scenarios[key].title}</h3>
      <p>{t.scenarios[key].text}</p>
    </li>
  ))}
</ul>

<style>
  .scenarios {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scenario {
    position: relative;
  }

  .scenario__index {
    position: absolute;
    top: var(--lk-space-5);
    right: var(--lk-space-5);
    font-size: 0.75rem;
    color: var(--lk-text-2);
  }

  .scenario :global(.scenario__icon) {
    color: var(--lk-text);
  }
</style>
