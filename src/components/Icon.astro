---
import type { HTMLAttributes } from 'astro/types';
import { ICON_PATHS, type IconName } from '../lib/icons';

interface Props extends Omit<HTMLAttributes<'svg'>, 'name'> {
  name: IconName;
  size?: number;
}

// Rest props are spread so the parent's scoped-style attribute (data-astro-cid-*) reaches the
// <svg>; without it, parent selectors such as `.theme-toggle__sun` never match.
const { name, size = 20, class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
  set:html={ICON_PATHS[name]}
/>
