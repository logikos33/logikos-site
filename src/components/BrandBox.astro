---
// The cover composition (brand page, OG card): the official wordmark inside a detection box
// (bracket corners, thin outline) with a mono label in a dark chip with a cyan square.
// No score, no accuracy. With `glitch`, the wordmark can run the signature glitch (replay).
import { dict } from '../i18n';
import type { Locale } from '../i18n/routes';
import Glitch from './Glitch.astro';
import Logo from './Logo.astro';

interface Props {
  locale: Locale;
  glitch?: boolean;
}

const { locale, glitch = false } = Astro.props;
const t = dict(locale);
---

<div class="brand-box" data-brand-box>
  <span class="brand-box__label">
    <span class="brand-box__mark" aria-hidden="true"></span>
    {t.brand.label}
  </span>
  {glitch ? <Glitch locale={locale} size={64} /> : <Logo locale={locale} size={64} />}
</div>

<style>
  .brand-box {
    position: relative;
    display: inline-block;
    padding: 0.62em 0.75em 0.5em;
    font-size: clamp(36px, 9vw, 64px);
    margin-top: 1.9rem;
    /* Corner brackets + a hairline contour, both in the interactive accent. */
    --c: var(--lk-accent);
    --len: 0.42em;
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--len) 2px,
      linear-gradient(var(--c), var(--c)) top left / 2px var(--len),
      linear-gradient(var(--c), var(--c)) top right / var(--len) 2px,
      linear-gradient(var(--c), var(--c)) top right / 2px var(--len),
      linear-gradient(var(--c), var(--c)) bottom left / var(--len) 2px,
      linear-gradient(var(--c), var(--c)) bottom left / 2px var(--len),
      linear-gradient(var(--c), var(--c)) bottom right / var(--len) 2px,
      linear-gradient(var(--c), var(--c)) bottom right / 2px var(--len);
    background-repeat: no-repeat;
    outline: 1px solid color-mix(in srgb, var(--lk-accent) 30%, transparent);
    outline-offset: -1px;
  }

  .brand-box__label {
    position: absolute;
    left: -1px;
    bottom: calc(100% + 6px);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.42rem 0.6rem;
    background: #0a0a0f;
    color: #f4f6f8;
    border: 1px solid #0a0a0f;
    font: 500 0.8125rem/1 var(--lk-font-mono);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  :global([data-theme='dark']) .brand-box__label {
    background: var(--lk-surface);
    border-color: var(--lk-line-strong);
  }

  .brand-box__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: #00e5ff;
  }
</style>
